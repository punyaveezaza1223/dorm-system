# Set this only when testing password recovery against a separate local API.
# Production should provide its deployed password-recovery API URL through its own environment.
VITE_PASSWORD_RECOVERY_API_URL=http://localhost:4010/api

# Use a separate local OTP/email-verification backend only for public
# verification request/confirmation endpoints. It never receives the 4000 JWT.
VITE_EMAIL_VERIFICATION_API_URL=http://localhost:4010/api
