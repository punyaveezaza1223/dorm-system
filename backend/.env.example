# Template only. Copy this file to .env; never commit .env or real credentials.
DB_HOST=localhost
DB_PORT=3310
DB_USER=react_user
DB_PASSWORD=replace-with-local-database-password
DB_NAME=react_db_otp_test

# Use mock for automated and local OTP tests. Set live only after explicit approval.
BREVO_EMAIL_MODE=mock
BREVO_API_KEY=replace-with-brevo-transactional-api-key
BREVO_SENDER_EMAIL=noreply@mail.kpnhaven.tech
BREVO_SENDER_NAME=KPN Haven

# Use distinct, randomly generated secrets of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-jwt-secret
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-reset-secret

# A third, distinct secret used only to hash email-verification links and
# request-rate values. Do not reuse either secret above in production.
EMAIL_VERIFICATION_SECRET=replace-with-a-third-long-random-verification-secret
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email
